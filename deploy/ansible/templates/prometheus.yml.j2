global: {scrape_interval: 1s, evaluation_interval: 1s, scrape_timeout: 800ms}
rule_files: [/etc/prometheus/alerts.yml]
scrape_configs:
  - job_name: coordinator
    scheme: https
    static_configs: [{targets: ['{{ begom_control }}:8444']}]
    tls_config: {ca_file: /run/secrets/ca.crt, cert_file: /run/secrets/client.crt, key_file: /run/secrets/client.key}
  - job_name: agents
    scheme: https
    static_configs:
{% for host in groups['agents'] %}
      - targets: ['{{ hostvars[host].begom_fqdn }}:9101']
        labels: {worker: '{{ host }}'}
{% endfor %}
    tls_config: {ca_file: /run/secrets/ca.crt, cert_file: /run/secrets/client.crt, key_file: /run/secrets/client.key}
  - job_name: nodes
    static_configs:
      - targets: [{% for host in groups['all'] %}'{{ hostvars[host].begom_fqdn }}:9100'{{ ',' if not loop.last else '' }}{% endfor %}]
  - job_name: openbao
    scheme: https
    metrics_path: /v1/sys/metrics
    params: {format: [prometheus]}
    static_configs: [{targets: ['{{ begom_control }}:8200']}]
    tls_config: {ca_file: /run/secrets/ca.crt}
  - job_name: nginx
    static_configs: [{targets: ['127.0.0.1:9113']}]
  - job_name: postgres
    static_configs: [{targets: ['127.0.0.1:9187']}]
  - job_name: fluent-bit
    metrics_path: /api/v1/metrics/prometheus
    static_configs: [{targets: [{% for host in groups['all'] %}'{{ hostvars[host].begom_fqdn }}:2020'{{ ',' if not loop.last else '' }}{% endfor %}]}]
  - job_name: prometheus
    static_configs: [{targets: ['127.0.0.1:9090']}]
  - job_name: loki
    static_configs: [{targets: ['127.0.0.1:3100']}]
  - job_name: grafana
    metrics_path: /grafana/metrics
    static_configs: [{targets: ['127.0.0.1:3000']}]
